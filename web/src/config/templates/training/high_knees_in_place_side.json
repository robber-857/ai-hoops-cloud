{
  "templateId": "high_knees_in_place_side",
  "mode": "training",
  "camera": "side",
  "displayName": "高抬腿｜原地高抬腿(侧面)",
  "categoryWeights": { "posture": 0.3, "execution": 0.5, "consistency": 0.2 },
  "options": { "targetDurationSec": 20 },
  "metrics": [
    {
      "metricId": "P_torso_upright",
      "category": "posture",
      "weight": 0.50,
      "type": "target",
      "computeKey": "torsoLeanDegSide",
      "params": { "target": 0, "tol": 12, "margin": 20 },
      "hint_bad": "Torso is rocking: keep the trunk upright, and avoid bending forward or rounding the back just to lift the knees."
    },
    {
      "metricId": "P_landing_position",
      "category": "posture",
      "weight": 0.50,
      "type": "range",
      "computeKey": "footStrikeOffsetXUnderHip",
      "params": { "L": -0.1, "U": 0.10, "margin": 0.20 },
      "hint_bad": "Foot landing is drifting: try to land the foot directly under the hips, and avoid kicking the leg forward."
    },
    {
      "metricId": "E_knee_height",
      "category": "execution",
      "weight": 0.60,
      "type": "target",
      "computeKey": "kneeToHipHeightRatioSide",
      "params": { "target": 1.00, "tol": 0.20, "margin": 0.35 },
      "hint_bad": "Knee lift is too low: raise the knee close to hip height, with the thigh nearly parallel to the floor."
    },
    {
      "metricId": "E_cadence",
      "category": "execution",
      "weight": 0.40,
      "type": "target",
      "computeKey": "cadenceSPM",
      "params": { "target": 160, "tol": 30, "margin": 50 },
      "hint_bad": "Cadence is too slow: keep the knee height first, then increase the speed of alternating legs."
    },
    {
      "metricId": "C_height_consistency",
      "category": "consistency",
      "weight": 0.50,
      "type": "target",
      "computeKey": "stdKneeToHipHeightRatioSide",
      "params": { "target": 0.30, "tol": 0.1, "margin": 0.15 },
      "hint_bad": "Knee height is inconsistent: even when tired, try to keep every knee lift at the same height."
    },
    {
      "metricId": "C_rhythm_stability",
      "category": "consistency",
      "weight": 0.50,
      "type": "target",
      "computeKey": "stepIntervalCV",
      "params": { "target": 0.2, "tol": 0.1, "margin": 0.17 },
      "hint_bad": "Rhythm is unstable: keep a steady running rhythm, like following a metronome."
    }
  ]
}
