{
  "templateId": "wall_sit_quarter_hold",
  "mode": "training",
  "camera": "side",
  "displayName": "靠墙四分之一蹲保持｜浅靠墙静蹲(侧面/约135°)",
  "categoryWeights": { "posture": 0.5, "execution": 0.3, "consistency": 0.2 },
  "options": { "targetHoldSec": 60 },
  "metrics": [
    {
      "metricId": "P_knee_angle_135",
      "category": "posture",
      "weight": 0.50,
      "type": "target",
      "computeKey": "avgKneeAngleDeg",
      "params": { "target": 135, "tol": 10, "margin": 20 },
      "hint_bad": "Squat depth is not correct: this is a shallow hold, so keep the knees slightly bent at about 135 degrees."
    },
    {
      "metricId": "P_trunk_vertical",
      "category": "posture",
      "weight": 0.30,
      "type": "target",
      "computeKey": "trunkLeanDegSide",
      "params": { "target": 0, "tol": 5, "margin": 10 },
      "hint_bad": "Back is not against the wall: keep the upper body fully vertical and pressed against the wall."
    },
    {
      "metricId": "P_knee_safe_zone",
      "category": "posture",
      "weight": 0.20,
      "type": "range",
      "computeKey": "kneeOverToeOffsetXSide",
      "params": { "L": -0.10, "U": 0.05, "margin": 0.10 },
      "hint_bad": "Knee pressure is too high: keep the shins close to vertical and avoid pushing the knees too far forward."
    },
    {
      "metricId": "E_hold_duration",
      "category": "execution",
      "weight": 1.0,
      "type": "target",
      "computeKey": "holdDurationSec",
      "params": { "target": 30, "tol": 15, "margin": 40 },
      "hint_bad": "Try to hold each training set for about 30 seconds."
    },
    {
      "metricId": "C_stability",
      "category": "consistency",
      "weight": 1.0,
      "type": "target",
      "computeKey": "stdKneeAngleDeg",
      "params": { "target": 3.5, "tol": 2.5, "margin": 5.0 },
      "hint_bad": "Posture is wobbling: keep the body still and steady."
    }
  ]
}
