{
  "templateId": "wall_sit_half_hold",
  "mode": "training",
  "camera": "side",
  "displayName": "靠墙半蹲保持｜标准靠墙静蹲(侧面/约90°)",
  "categoryWeights": { "posture": 0.5, "execution": 0.3, "consistency": 0.2 },
  "options": { "targetHoldSec": 45 },
  "metrics": [
    {
      "metricId": "P_knee_angle_90",
      "category": "posture",
      "weight": 0.50,
      "type": "target",
      "computeKey": "avgKneeAngleDeg",
      "params": { "target": 90, "tol": 10, "margin": 15 },
      "hint_bad": "Squat depth is not correct: the thighs should be parallel to the floor, with the knees close to a 90-degree angle."
    },
    {
      "metricId": "P_trunk_vertical",
      "category": "posture",
      "weight": 0.30,
      "type": "target",
      "computeKey": "trunkLeanDegSide",
      "params": { "target": 0, "tol": 5, "margin": 10 },
      "hint_bad": "Back is not against the wall: keep the upper body fully vertical and pressed firmly against the wall."
    },
    {
      "metricId": "P_knee_position",
      "category": "posture",
      "weight": 0.20,
      "type": "range",
      "computeKey": "kneeOverToeOffsetXSide",
      "params": { "L": -0.05, "U": 0.08, "margin": 0.12 },
      "hint_bad": "Knee position is not ideal: adjust the distance between the feet and the wall so the knees do not move too far past the toes."
    },
    {
      "metricId": "E_hold_duration",
      "category": "execution",
      "weight": 1.0,
      "type": "target",
      "computeKey": "holdDurationSec",
      "params": { "target": 30, "tol": 15, "margin": 30 },
      "hint_bad": "Try to hold the position for the target time of about 30 seconds."
    },
    {
      "metricId": "C_depth_stability",
      "category": "consistency",
      "weight": 1.0,
      "type": "target",
      "computeKey": "stdKneeAngleDeg",
      "params": { "target": 3.0, "tol": 2.0, "margin": 5.0 },
      "hint_bad": "Body is moving up and down: avoid sliding on the wall and hold the position firmly."
    }
  ]
}
